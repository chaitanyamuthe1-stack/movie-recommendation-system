# Copy to .env and fill in real values. NEVER commit .env.
ENV=development
DEBUG=True
PORT=8000

# Database (SQLite for local dev, PostgreSQL in Docker)
DATABASE_URL=sqlite:///./recommender.db

# Used by docker-compose for the postgres service
POSTGRES_USER=movierec
POSTGRES_PASSWORD=change-me
POSTGRES_DB=movierec_db

# Cache (falls back to in-memory if Redis is offline)
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL=3600

# Security - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS (comma separated)
CORS_ORIGINS=http://localhost,http://localhost:5173

# Optional external APIs
TMDB_API_KEY=
OPENAI_API_KEY=
