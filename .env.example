# Environment Configuration Template
ENV=development
DEBUG=True
PORT=8000

# Database Connection (Defaults to SQLite for local development)
DATABASE_URL=sqlite:///./recommender.db
# DATABASE_URL=postgresql://movierec:secretpassword@localhost:5432/movierec_db

# Redis Cache (Falls back to in-memory dictionary if Redis is offline)
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL=3600

# Security & Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production-783921
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# External APIs (Optional - catalog is pre-seeded with TMDB metadata)
TMDB_API_KEY=
OPENAI_API_KEY=
